# VMS Camera Server - Environment Configuration
# Copy this to .env and update values before deploying

# ─── Security ───────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a strong random secret in production!
JWT_SECRET=change-me-to-a-very-long-random-secret-in-production
ADMIN_BOOTSTRAP_PASSWORD=change-me-to-a-strong-admin-password

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Public port for nginx (Docker)
VMS_PORT=8080

# Host IP to bind nginx frontend port to (set to your static LAN/Cato IP)
VMS_FRONTEND_HOST_IP=10.0.11.215

# Docker host data root (set this on Windows to use a separate drive, e.g. V:/VMSData)
VMS_DATA_ROOT=

# CORS allowed origins (comma-separated for multiple)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Optional absolute path to ffmpeg executable (recommended for Windows service installs)
FFMPEG_PATH=

# ─── Storage ────────────────────────────────────────────────────────────────
# Paths for data storage (defaults to ./data/ relative to backend)
DB_PATH=./data/vms.db
RECORDINGS_DIR=./data/recordings
STREAMS_DIR=./data/streams
SNAPSHOTS_DIR=./data/snapshots
THUMBNAILS_DIR=./data/thumbnails

# ─── Recording ──────────────────────────────────────────────────────────────
# How many days to keep recordings (auto-purged)
RETENTION_DAYS=30

# Segment length in seconds (default 600 = 10 minutes)
SEGMENT_DURATION=600

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
