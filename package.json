{
  "name": "vms-camera-server",
  "version": "1.0.0",
  "description": "VMS Pro - Professional Video Management System",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend run start",
    "desktop:install": "npm install --prefix desktop-client",
    "desktop:build:win": "npm --prefix desktop-client run build:win",
    "server:package:win": "bash scripts/build-windows-server-package.sh",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "npm run build && docker compose up -d --build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
